---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Partners from '../components/Partners.astro';
import Approach from '../components/Approach.astro';
import CtaBand from '../components/CtaBand.astro';
import { useContent } from '../i18n/utils';

const lang = 'de' as const;
const t = useContent(lang);
---

<BaseLayout lang={lang} page="firm">
  <PageHeader
    eyebrow={t.firmSection.eyebrow}
    title={t.firmSection.title}
    lead={t.firmSection.lead}
  />
  <Partners lang={lang} detailed showHeader={false} surface={false} />
  <Approach lang={lang} />
  <CtaBand lang={lang} />
</BaseLayout>
