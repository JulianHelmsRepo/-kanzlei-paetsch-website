---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import BlogArticleList from '../../../components/BlogArticleList.astro';
import BlogReveal from '../../../components/BlogReveal.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { getArticles, SHOW_DE_BLOG } from '../../../lib/blog';
import { routes } from '../../../i18n/utils';

const lang = 'de' as const;
const articles = await getArticles('de');
---

<BaseLayout
  lang={lang}
  page="blog"
  title="Blog auf Deutsch – Kanzlei Paetsch"
  description="Beiträge und Praxistipps der Kanzlei Paetsch zu Arbeitsrecht, Gesellschaftsrecht, Insolvenzrecht und Mietrecht."
  canonicalPath={`${routes[lang].blog}de/`}
  noindex={!SHOW_DE_BLOG}
>
  <PageHeader eyebrow="Blog" title="Beiträge und Praxistipps" lead="Rechtliche Themen aus unserer Beratungspraxis, verständlich erklärt." />

  <section class="section blog-list">
    <div class="container">
      <div class="blog-list__toggle">
        <a class="btn btn-ghost" href={routes[lang].blog}>← Aktuelles</a>
        <a class="btn btn-ghost" href={`${routes[lang].blog}es/`}>Español</a>
      </div>
      <BlogArticleList articles={articles} emptyMessage="Der deutsche Blog-Bereich befindet sich im Aufbau – schauen Sie bald wieder vorbei." />
    </div>
  </section>

  <CtaBand lang={lang} />
  <BlogReveal />
</BaseLayout>

<style>
  .blog-list__toggle {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 2.5rem;
  }
</style>
