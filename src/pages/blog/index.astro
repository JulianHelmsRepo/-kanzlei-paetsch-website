---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogReveal from '../../components/BlogReveal.astro';
import CtaBand from '../../components/CtaBand.astro';
import { routes } from '../../i18n/utils';

const lang = 'de' as const;
const r = routes[lang];

const columns = [
  {
    href: `${r.blog}de/`,
    eyebrow: 'Aktuelles',
    title: 'Aktuelles und Praxistipps',
    lead: 'Beiträge und Praxistipps aus unserer Beratungspraxis – auf Deutsch.',
    cta: 'Deutsch',
  },
  {
    href: `${r.blog}es/`,
    eyebrow: 'Noticias',
    title: 'Noticias y consejos prácticos',
    lead: 'Artículos y consejos prácticos de nuestra experiencia legal – en español.',
    cta: 'Español',
  },
];
---

<BaseLayout lang={lang} page="blog">
  <h1 class="visually-hidden">Aktuelles und Praxistipps / Noticias y consejos prácticos</h1>

  <section class="section blog-hub">
    <div class="container">
      <div class="blog-hub__grid">
        {
          columns.map((col) => (
            <a class="blog-hub__col blog-reveal" href={col.href}>
              <p class="eyebrow">{col.eyebrow}</p>
              <h2 class="blog-hub__col-title">{col.title}</h2>
              <p class="blog-hub__col-lead lead">{col.lead}</p>
              <span class="blog-hub__col-cta">
                {col.cta}<span class="arrow" aria-hidden="true">→</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand lang={lang} />
  <BlogReveal />
</BaseLayout>

<style>
  .blog-hub {
    padding-top: clamp(2.75rem, 6vw, 4.5rem);
  }
  .blog-hub__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
  }
  .blog-hub__col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    padding: clamp(2rem, 4vw, 2.75rem) clamp(1.5rem, 3vw, 2.5rem);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    color: var(--c-primary);
    transition: border-color var(--transition), background var(--transition);
  }
  .blog-hub__col:hover {
    border-color: var(--c-primary);
    background: var(--c-surface);
    color: var(--c-primary);
  }
  .blog-hub__col-title {
    font-size: clamp(1.9rem, 4vw, 2.4rem);
    margin-top: 0.5rem;
  }
  .blog-hub__col-lead {
    margin-top: 0.5rem;
  }
  .blog-hub__col-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-primary);
  }
  .blog-hub__col-cta .arrow {
    color: var(--c-accent);
    transition: transform var(--transition);
  }
  .blog-hub__col:hover .blog-hub__col-cta .arrow {
    transform: translateX(4px);
  }

  @media (max-width: 760px) {
    .blog-hub__grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
