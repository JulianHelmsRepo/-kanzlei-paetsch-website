---
import type { Lang, PageKey } from '../i18n/ui';
import { routes, useContent } from '../i18n/utils';

interface Props {
  lang: Lang;
  page: PageKey;
}
const { lang, page } = Astro.props;
const t = useContent(lang);

const items: { code: Lang; label: string; href: string }[] = [
  { code: 'de', label: 'DE', href: routes.de[page] },
  { code: 'en', label: 'EN', href: routes.en[page] },
];
---

<div class="lang" role="group" aria-label={t.a11y.toggleLang}>
  {
    items.map((item, i) => (
      <>
        {i > 0 && <span class="lang__sep" aria-hidden="true">|</span>}
        {item.code === lang ? (
          <span class="lang__item lang__item--active" aria-current="true">
            {item.label}
          </span>
        ) : (
          <a class="lang__item" href={item.href} hreflang={item.code} lang={item.code}>
            {item.label}
          </a>
        )}
      </>
    ))
  }
</div>

<style>
  .lang {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }
  .lang__item {
    color: var(--c-border-strong);
  }
  .lang__item--active {
    color: var(--c-primary);
    font-weight: 600;
  }
  a.lang__item:hover {
    color: var(--c-primary);
  }
  .lang__sep {
    color: var(--c-border-strong);
  }
</style>
