---
import type { Lang, PageKey } from '../i18n/ui';
import { routes, useContent } from '../i18n/utils';
import Logo from './Logo.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  lang: Lang;
  page: PageKey;
}
const { lang, page } = Astro.props;
const t = useContent(lang);
const r = routes[lang];

const navLinks: { key: PageKey; label: string }[] = [
  { key: 'practice', label: t.nav.practice },
  { key: 'firm', label: t.nav.firm },
  { key: 'contact', label: t.nav.contact },
];
---

<header class="site-header" data-header>
  <div class="site-header__inner container">
    <Logo href={r.home} />

    <nav class="nav nav--desktop" aria-label="Hauptnavigation">
      {
        navLinks.map((l) => (
          <a
            class="nav__link"
            href={routes[lang][l.key]}
            aria-current={page === l.key ? 'page' : undefined}
          >
            {l.label}
          </a>
        ))
      }
      <span class="nav__divider" aria-hidden="true"></span>
      <LanguageSwitcher lang={lang} page={page} />
    </nav>

    <button
      class="nav-toggle"
      data-nav-toggle
      data-label-open={t.a11y.openMenu}
      data-label-close={t.a11y.closeMenu}
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label={t.a11y.openMenu}
    >
      <span class="nav-toggle__bar"></span>
      <span class="nav-toggle__bar"></span>
      <span class="nav-toggle__bar"></span>
    </button>
  </div>

  <div class="mobile-nav" id="mobile-nav" data-mobile-nav hidden>
    <nav class="mobile-nav__list" aria-label="Mobile Navigation">
      {
        navLinks.map((l) => (
          <a
            class="mobile-nav__link"
            href={routes[lang][l.key]}
            aria-current={page === l.key ? 'page' : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </nav>
    <div class="mobile-nav__lang">
      <LanguageSwitcher lang={lang} page={page} />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: saturate(180%) blur(8px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--transition), box-shadow var(--transition);
  }
  .site-header[data-scrolled] {
    border-bottom-color: var(--c-border);
    box-shadow: var(--shadow-sm);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 76px;
  }

  .nav--desktop {
    display: flex;
    align-items: center;
    gap: 2.25rem;
  }
  .nav__link {
    font-size: 0.95rem;
    letter-spacing: 0.01em;
    color: var(--c-text);
    position: relative;
    padding-block: 0.25rem;
  }
  .nav__link:hover {
    color: var(--c-primary);
  }
  .nav__link[aria-current='page'] {
    color: var(--c-primary);
  }
  .nav__link[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 1.5px;
    background: var(--c-accent);
  }
  .nav__divider {
    width: 1px;
    height: 18px;
    background: var(--c-border);
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 0;
    background: transparent;
    border: none;
    cursor: pointer;
  }
  .nav-toggle__bar {
    display: block;
    width: 24px;
    height: 1.5px;
    margin-inline: auto;
    background: var(--c-primary);
    transition: transform var(--transition), opacity var(--transition);
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle__bar:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle__bar:nth-child(2) {
    opacity: 0;
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle__bar:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
  }

  .mobile-nav {
    position: fixed;
    top: 76px;
    left: 0;
    right: 0;
    height: calc(100vh - 76px);
    height: calc(100dvh - 76px);
    z-index: 90;
    border-top: 1px solid var(--c-border);
    background: var(--c-bg);
    padding: 1.25rem var(--gutter) 2rem;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .mobile-nav__list {
    display: flex;
    flex-direction: column;
  }
  .mobile-nav__link {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    color: var(--c-primary);
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--c-border);
  }
  .mobile-nav__lang {
    margin-top: 1.25rem;
  }

  @media (max-width: 820px) {
    .nav--desktop {
      display: none;
    }
    .nav-toggle {
      display: flex;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-mobile-nav]');

  const openLabel = toggle?.getAttribute('data-label-open') ?? 'Menu';
  const closeLabel = toggle?.getAttribute('data-label-close') ?? 'Close';

  // Sticky-Header: Rahmen/Schatten ab etwas Scroll
  const onScroll = () => {
    if (!header) return;
    if (window.scrollY > 8) header.setAttribute('data-scrolled', '');
    else header.removeAttribute('data-scrolled');
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Mobile-Menü
  const setOpen = (open: boolean) => {
    if (!toggle || !panel) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? closeLabel : openLabel);
    panel.hidden = !open;
    document.body.style.overflow = open ? 'hidden' : '';
  };

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    setOpen(!open);
  });

  // Beim Klick auf einen Link oder Escape schließen
  panel?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => setOpen(false))
  );
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
</script>
