---
import { firm } from '../i18n/ui';

interface Props {
  href: string;
  tone?: 'dark' | 'light';
  size?: 'sm' | 'md';
}
const { href, tone = 'dark', size = 'sm' } = Astro.props;
---

<a class:list={['logo', `logo--${tone}`, `logo--${size}`]} href={href} aria-label={firm.name}>
  <svg class="logo__mark" viewBox="0 0 24 96" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="logoMarkSilver" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#cfd6dc" />
        <stop offset="45%" stop-color="#9aa5b1" />
        <stop offset="100%" stop-color="#75808d" />
      </linearGradient>
    </defs>
    <polygon points="5,0 23,0 9,96 0,96 5,66" fill="url(#logoMarkSilver)" />
    <line x1="7" y1="3" x2="7" y2="53" stroke="currentColor" stroke-width="2.4" />
  </svg>
  <span class="logo__name">{firm.name}</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--c-primary);
  }
  .logo:hover {
    color: var(--c-primary);
  }
  .logo__mark {
    display: block;
    width: auto;
    height: 3.7rem;
    flex-shrink: 0;
  }
  .logo__name {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    letter-spacing: 0.02em;
    color: inherit;
  }

  .logo--md .logo__mark {
    height: 4.4rem;
  }
  .logo--md .logo__name {
    font-size: 1.4rem;
  }

  .logo--light,
  .logo--light:hover {
    color: #fff;
  }

  @media (max-width: 420px) {
    .logo__name {
      font-size: 1.05rem;
    }
  }
</style>
