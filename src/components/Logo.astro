---
import { Image } from 'astro:assets';
import { firm } from '../i18n/ui';
import logoMark from '../assets/logo-mark.png';

interface Props {
  href: string;
  tone?: 'dark' | 'light';
  size?: 'sm' | 'md';
}
const { href, tone = 'dark', size = 'sm' } = Astro.props;
---

<a class:list={['logo', `logo--${tone}`, `logo--${size}`]} href={href} aria-label={firm.name}>
  <Image src={logoMark} alt="" class="logo__mark" width={60} height={141} />
  <span class="logo__name">{firm.name}</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--c-primary);
  }
  .logo:hover {
    color: var(--c-primary);
  }
  .logo__mark {
    display: inline-block;
    width: auto;
    height: 3.3rem;
  }
  .logo__name {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    letter-spacing: 0.02em;
    color: inherit;
  }

  .logo--md .logo__mark {
    height: 3.9rem;
  }
  .logo--md .logo__name {
    font-size: 1.4rem;
  }

  .logo--light,
  .logo--light:hover {
    color: #fff;
  }

  @media (max-width: 420px) {
    .logo__name {
      font-size: 1.05rem;
    }
  }
</style>
