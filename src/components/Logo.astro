---
import { firm } from '../i18n/ui';

interface Props {
  href: string;
  tone?: 'dark' | 'light';
  size?: 'sm' | 'md';
}
const { href, tone = 'dark', size = 'sm' } = Astro.props;
---

<a class:list={['logo', `logo--${tone}`, `logo--${size}`]} href={href} aria-label={firm.name}>
  <svg class="logo__mark" viewBox="0 0 36 108" aria-hidden="true" focusable="false">
    <path d="M9 4 H12 L10.5 77 L8 91 Z" fill="currentColor" />
    <path d="M18 4 H28 L12 104 H3 Z" fill="#9AA5B1" />
  </svg>
  <span class="logo__name">{firm.name}</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--c-primary);
  }
  .logo:hover {
    color: var(--c-primary);
  }
  .logo__mark {
    display: block;
    width: auto;
    height: 3.3rem;
    flex-shrink: 0;
  }
  .logo__name {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    letter-spacing: 0.02em;
    color: inherit;
  }

  .logo--md .logo__mark {
    height: 4.4rem;
  }
  .logo--md .logo__name {
    font-size: 1.4rem;
  }

  .logo--light,
  .logo--light:hover {
    color: #fff;
  }

  @media (max-width: 420px) {
    .logo__name {
      font-size: 1.05rem;
    }
  }
</style>
