---
import type { Lang, PageKey } from '../i18n/ui';
import { firm } from '../i18n/ui';
import { routes, useContent } from '../i18n/utils';
import Logo from './Logo.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useContent(lang);
const r = routes[lang];
const year = new Date().getFullYear();

const navLinks: { key: PageKey; label: string }[] = [
  { key: 'practice', label: t.nav.practice },
  { key: 'firm', label: t.nav.firm },
  { key: 'contact', label: t.nav.contact },
];
const legalLinks: { key: PageKey; label: string }[] = [
  { key: 'imprint', label: t.legalPages.imprint.title },
  { key: 'privacy', label: t.legalPages.privacy.title },
];
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <Logo href={r.home} tone="light" />
      <p class="site-footer__blurb">{t.footer.blurb}</p>
      <address class="site-footer__address">
        {firm.legalName}<br />
        {firm.street}, {firm.city}<br />
        <a href={firm.phoneHref}>{firm.phoneDisplay}</a> ·
        <a href={`mailto:${firm.email}`}>{firm.email}</a>
      </address>
    </div>

    <div class="site-footer__navgroup">
      <nav class="site-footer__col" aria-label={t.footer.nav}>
        <h2 class="site-footer__heading">{t.footer.nav}</h2>
        <ul>
          {navLinks.map((l) => <li><a href={routes[lang][l.key]}>{l.label}</a></li>)}
        </ul>
      </nav>

      <nav class="site-footer__col" aria-label={t.footer.legal}>
        <h2 class="site-footer__heading">{t.footer.legal}</h2>
        <ul>
          {legalLinks.map((l) => <li><a href={routes[lang][l.key]}>{l.label}</a></li>)}
        </ul>
      </nav>
    </div>
  </div>

  <div class="container site-footer__bottom">
    <span>© {year} {firm.name} – {firm.legalName}</span>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--c-primary);
    color: var(--c-on-primary);
    padding-block: clamp(3rem, 6vw, 4.5rem) 2rem;
    margin-top: auto;
  }
  .site-footer__inner {
    display: grid;
    grid-template-columns: 1fr var(--layout-aside);
    gap: clamp(2rem, 5vw, 4rem);
    padding-bottom: 2.5rem;
    border-bottom: 1px solid #4c5f6e;
  }
  .site-footer__navgroup {
    display: flex;
    gap: clamp(2rem, 4vw, 3.25rem);
    justify-content: flex-start;
  }
  .site-footer__navgroup .site-footer__col {
    min-width: 8rem;
  }
  .site-footer__blurb {
    margin-top: 1.1rem;
    max-width: 34ch;
    color: #d7dde1;
    font-size: 0.95rem;
    line-height: 1.7;
  }
  .site-footer__address {
    margin-top: 1.25rem;
    font-style: normal;
    font-size: 0.9rem;
    line-height: 1.8;
    color: #d7dde1;
  }
  .site-footer__address a {
    color: #d7dde1;
  }
  .site-footer__address a:hover {
    color: #fff;
  }
  .site-footer__heading {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-accent);
    margin: 0 0 1rem;
  }
  .site-footer__col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .site-footer__col a {
    color: #d7dde1;
    font-size: 0.95rem;
  }
  .site-footer__col a:hover {
    color: #fff;
  }
  .site-footer__bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--c-accent);
  }

  @media (max-width: 720px) {
    .site-footer__inner {
      grid-template-columns: 1fr;
    }
    .site-footer__navgroup {
      justify-content: flex-start;
    }
  }
  @media (max-width: 380px) {
    .site-footer__navgroup {
      flex-direction: column;
      gap: 1.75rem;
    }
  }
</style>
