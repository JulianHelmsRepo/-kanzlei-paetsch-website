---
import type { Lang } from '../i18n/ui';
import { routes, useContent } from '../i18n/utils';

interface Props {
  lang: Lang;
  detailed?: boolean; // true = lange Beschreibungen (Rechtsgebiete-Seite)
  showHeader?: boolean;
  linkAll?: boolean; // Link "Alle Rechtsgebiete" anzeigen
}
const { lang, detailed = false, showHeader = true, linkAll = false } = Astro.props;
const t = useContent(lang);
const areas = t.practiceAreas;
---

<section class="areas section" id="rechtsgebiete">
  <div class="container">
    {
      showHeader && (
        <div class="areas__head reveal">
          <div>
            <p class="eyebrow">{t.practiceSection.eyebrow}</p>
            <h2 class="section-title">{t.practiceSection.title}</h2>
          </div>
          <span class="areas__count">{t.practiceSection.count}</span>
        </div>
      )
    }

    {
      detailed ? (
        <ol class="areas__grid">
          {areas.map((area) => (
            <li class="area-card reveal">
              <div class="area-card__head">
                <span class="area-card__num">{area.num}</span>
                <h3 class="area-card__title">{area.title}</h3>
              </div>
              <p class="area-card__lead">{area.long}</p>
              <ul class="area-card__points">
                {area.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            </li>
          ))}
        </ol>
      ) : (
        <ol class="areas__list">
          {areas.map((area) => (
            <li class="area reveal">
              <span class="area__num">{area.num}</span>
              <h3 class="area__title">{area.title}</h3>
              <p class="area__text">{area.short}</p>
            </li>
          ))}
        </ol>
      )
    }

    {
      linkAll && (
        <div class="areas__more reveal">
          <a class="btn btn-ghost" href={routes[lang].practice}>
            {t.practiceSection.viewAll}<span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
      )
    }
  </div>
</section>

<style>
  .areas__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    padding-bottom: 1.5rem;
    margin-bottom: 0.5rem;
    border-bottom: 1px solid var(--c-border);
  }
  .areas__count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--c-text-subtle);
    white-space: nowrap;
  }
  .areas__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .area {
    display: grid;
    grid-template-columns: 72px 1fr 1.5fr;
    gap: clamp(1rem, 3vw, 2rem);
    align-items: baseline;
    padding: 1.7rem 0.75rem;
    border-bottom: 1px solid var(--c-border);
    transition: background var(--transition), padding-left var(--transition);
  }
  .area:hover {
    background: var(--c-surface);
    padding-left: 1.25rem;
  }
  .area__num {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--c-accent);
  }
  .area__title {
    font-size: 1.35rem;
    color: var(--c-primary);
  }
  .area__text {
    font-size: 1rem;
    color: var(--c-text-muted);
    line-height: 1.65;
  }
  .areas__more {
    margin-top: 2.25rem;
  }

  @media (max-width: 760px) {
    .area {
      grid-template-columns: 44px 1fr;
      row-gap: 0.5rem;
    }
    .area__text {
      grid-column: 2 / -1;
    }
    .area:hover {
      padding-left: 0.75rem;
    }
  }

  /* ---------- Detailansicht: Karten-Grid ---------- */
  .areas__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(1.5rem, 3vw, 2rem);
  }
  .area-card {
    padding: clamp(1.75rem, 3vw, 2.25rem);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    background: var(--c-bg);
    transition: border-color var(--transition), box-shadow var(--transition);
  }
  .area-card:hover {
    border-color: var(--c-border-strong);
    box-shadow: var(--shadow-sm);
  }
  .area-card__head {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    padding-bottom: 1.1rem;
    margin-bottom: 1.1rem;
    border-bottom: 1px solid var(--c-border);
  }
  .area-card__num {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--c-accent);
  }
  .area-card__title {
    font-size: 1.3rem;
    color: var(--c-primary);
  }
  .area-card__lead {
    color: var(--c-text-muted);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }
  .area-card__points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .area-card__points li {
    position: relative;
    padding-left: 1.1rem;
    font-size: 0.95rem;
    color: var(--c-text);
    line-height: 1.5;
  }
  .area-card__points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 6px;
    height: 1px;
    background: var(--c-accent);
  }

  @media (max-width: 760px) {
    .areas__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
