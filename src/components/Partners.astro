---
import { Image } from 'astro:assets';
import type { Lang } from '../i18n/ui';
import { routes, useContent } from '../i18n/utils';
import fabianPhoto from '../assets/images/fabian-paetsch.jpeg';
import frederikPhoto from '../assets/images/frederik-voltmann.webp';

const partnerPhotos: Record<string, ImageMetadata> = {
  'Fabian Paetsch': fabianPhoto,
  'Frederik Voltmann': frederikPhoto,
};

interface Props {
  lang: Lang;
  detailed?: boolean; // Bio anzeigen (Kanzlei-Seite)
  linkTeam?: boolean;
  surface?: boolean; // hellgrauer Hintergrund
  showHeader?: boolean;
}
const {
  lang,
  detailed = false,
  linkTeam = false,
  surface = true,
  showHeader = true,
} = Astro.props;
const t = useContent(lang);
---

<section class:list={['partners section', { 'partners--surface': surface }]} id="kanzlei">
  <div class="container">
    {
      showHeader && (
        <div class="partners__head reveal">
          <p class="eyebrow">{t.firmSection.eyebrow}</p>
          <h2 class="section-title">{t.firmSection.title}</h2>
          <p class="lead partners__lead">{t.firmSection.lead}</p>
        </div>
      )
    }

    <div class="partners__grid">
      {
        t.partners.map((p) => (
          <article class="partner reveal">
            <Image
              src={partnerPhotos[p.name]}
              alt={p.imageCaption}
              widths={[300, 360, 480, 720, 960]}
              sizes="(max-width: 680px) 45vw, 300px"
              quality={90}
              class="partner__photo"
            />
            <div class="partner__body">
              <h3 class="partner__name">{p.name}</h3>
              <p class="partner__role">{p.role}</p>
              <p class="partner__areas">{p.areas}</p>
              {detailed && <p class="partner__bio">{p.bio}</p>}
            </div>
          </article>
        ))
      }
    </div>

    {
      linkTeam && (
        <div class="partners__more reveal">
          <a class="btn btn-ghost" href={routes[lang].firm}>
            {t.firmSection.viewTeam}<span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
      )
    }
  </div>
</section>

<style>
  .partners--surface {
    background: var(--c-surface);
  }
  .partners__head {
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }
  .partners__lead {
    margin-top: 1rem;
  }
  .partners__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(3rem, 9vw, 7rem);
  }
  .partner__photo {
    width: 100%;
    max-width: 300px;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
  }
  .partner__body {
    margin-top: 1.4rem;
  }
  .partner__name {
    font-size: 1.5rem;
    color: var(--c-primary);
  }
  .partner__role {
    margin-top: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-text-subtle);
  }
  .partner__areas {
    margin-top: 0.6rem;
    font-size: 0.95rem;
    color: var(--c-text-muted);
    line-height: 1.6;
    max-width: 34ch;
  }
  .partner__bio {
    margin-top: 1rem;
    font-size: 1rem;
    color: var(--c-text-muted);
    line-height: 1.7;
    max-width: 42ch;
  }
  .partners__more {
    margin-top: 2.5rem;
  }

  @media (max-width: 680px) {
    .partners__grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
