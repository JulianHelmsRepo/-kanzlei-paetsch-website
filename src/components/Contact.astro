---
import type { Lang } from '../i18n/ui';
import { firm } from '../i18n/ui';
import { routes, useContent } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useContent(lang);
const f = t.contactSection.form;
---

<section class="contact section" id="kontakt">
  <div class="container contact__inner">
    <div class="contact__info reveal">
      <p class="eyebrow">{t.contactSection.eyebrow}</p>
      <h1 class="section-title contact__title">{t.contactSection.title}</h1>
      <p class="lead contact__lead">{t.contactSection.lead}</p>

      <dl class="contact__details">
        <div>
          <dt>{t.contactSection.phoneLabel}</dt>
          <dd><a href={firm.phoneHref}>{firm.phoneDisplay}</a></dd>
        </div>
        <div>
          <dt>{t.contactSection.emailLabel}</dt>
          <dd><a href={`mailto:${firm.email}`}>{firm.email}</a></dd>
        </div>
        <div>
          <dt>{t.contactSection.addressLabel}</dt>
          <dd>{firm.street}<br />{firm.city}</dd>
        </div>
        <div>
          <dt>{t.contactSection.hoursLabel}</dt>
          <dd>{t.contactSection.hours}</dd>
        </div>
      </dl>
    </div>

    <div class="contact__form-wrap reveal">
      <form class="contact-form" data-contact-form novalidate>
        <p class="contact-form__notice">
          Bitte senden Sie über dieses Formular keine vertraulichen Mandatsdetails
          — nur eine allgemeine Anfrage.
        </p>
        <div class="contact-form__row">
          <div class="field">
            <label for="cf-name">{f.name} *</label>
            <input id="cf-name" name="name" type="text" required maxlength="200" placeholder={f.namePlaceholder} autocomplete="name" />
          </div>
          <div class="field">
            <label for="cf-company">{f.company}</label>
            <input id="cf-company" name="company" type="text" maxlength="200" placeholder={f.companyPlaceholder} autocomplete="organization" />
          </div>
        </div>

        <div class="contact-form__row">
          <div class="field">
            <label for="cf-email">{f.email} *</label>
            <input id="cf-email" name="email" type="email" required maxlength="200" placeholder={f.emailPlaceholder} autocomplete="email" />
          </div>
          <div class="field">
            <label for="cf-phone">{f.phone}</label>
            <input id="cf-phone" name="phone" type="tel" maxlength="60" placeholder={f.phonePlaceholder} autocomplete="tel" />
          </div>
        </div>

        <div class="contact-form__row">
          <div class="field">
            <label for="cf-area">{f.area}</label>
            <select id="cf-area" name="area">
              {t.practiceAreas.map((a) => <option>{a.title}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="cf-urgency">{f.urgency}</label>
            <select id="cf-urgency" name="urgency">
              {f.urgencyOptions.map((o) => <option>{o}</option>)}
            </select>
          </div>
        </div>

        <div class="field">
          <label for="cf-message">{f.message} *</label>
          <textarea id="cf-message" name="message" rows="5" required maxlength="5000" placeholder={f.messagePlaceholder}></textarea>
        </div>

        {/* Honeypot: für Menschen und Screenreader unsichtbar, nur Bots füllen dies aus. */}
        <div class="hp-field" aria-hidden="true">
          <label for="cf-website">Website (bitte frei lassen)</label>
          <input id="cf-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <label class="field-consent">
          <input type="checkbox" name="consent" required />
          <span>
            {f.consentPre}<a href={routes[lang].privacy}>{f.consentLink}</a>{f.consentPost}
          </span>
        </label>

        <div class="contact-form__foot">
          <button type="submit" class="btn btn-primary" data-submit>{f.submit}</button>
          <span class="contact-form__hint">{f.note}</span>
        </div>

        <p class="contact-form__status" role="status" aria-live="polite" data-status hidden></p>
      </form>
    </div>
  </div>
</section>

<style>
  .contact__inner {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2rem, 6vw, 4rem);
    align-items: start;
  }
  .contact__title {
    margin-top: 0.7rem;
    max-width: 14ch;
  }
  .contact__lead {
    margin-top: 1rem;
    max-width: 40ch;
  }
  .contact__details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem 2rem;
    margin: 2rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--c-border);
  }
  .contact__details dt {
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-text-subtle);
  }
  .contact__details dd {
    margin: 0.35rem 0 0;
    font-family: var(--font-serif);
    font-size: 1.1rem;
    color: var(--c-primary);
    line-height: 1.4;
  }

  .contact__form-wrap {
    background: var(--c-bg);
    border: 1px solid var(--c-border);
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }
  /* Honeypot: für Nutzer und Screenreader unsichtbar, aber nicht display:none
     (manche Bots meiden display:none-Felder). */
  .hp-field {
    position: absolute;
    left: -9999px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .contact-form__status {
    font-size: 0.9rem;
    line-height: 1.5;
    padding: 0.75rem 0.9rem;
    margin: 0;
    border-left: 2px solid var(--c-border-strong);
    background: var(--c-surface);
    color: var(--c-text);
  }
  .contact-form__status[data-state='success'] {
    border-left-color: var(--c-accent);
    color: var(--c-primary);
  }
  .contact-form__status[data-state='error'] {
    border-left-color: #b3261e;
    color: #b3261e;
  }
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }
  .contact-form__notice {
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--c-text-muted);
    background: var(--c-surface);
    border-left: 2px solid var(--c-accent);
    padding: 0.7rem 0.9rem;
    margin: 0;
  }
  .contact-form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.4rem;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .field label {
    font-size: 0.75rem;
    letter-spacing: 0.03em;
    color: var(--c-text-muted);
  }
  .field input,
  .field select,
  .field textarea {
    font-family: var(--font-sans);
    font-size: 1rem;
    color: var(--c-text);
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--c-border-strong);
    padding: 0.55rem 0.15rem;
    transition: border-color var(--transition);
  }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-bottom-color: var(--c-primary);
  }
  .field textarea {
    resize: vertical;
    min-height: 96px;
  }
  .field-consent {
    display: flex;
    gap: 0.7rem;
    align-items: flex-start;
    font-size: 0.85rem;
    color: var(--c-text-muted);
    line-height: 1.5;
  }
  .field-consent input {
    margin-top: 0.2rem;
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    accent-color: var(--c-primary);
  }
  .contact-form__foot {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }
  .btn-primary:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }
  .contact-form__hint {
    font-size: 0.8rem;
    color: var(--c-text-subtle);
  }

  @media (max-width: 900px) {
    .contact__inner {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 520px) {
    .contact-form__row,
    .contact__details {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');

  if (form) {
    const submitBtn = form.querySelector<HTMLButtonElement>('[data-submit]');
    const status = form.querySelector<HTMLElement>('[data-status]');
    const consent = form.querySelector<HTMLInputElement>('input[name="consent"]');
    const submitLabel = submitBtn?.textContent ?? 'Anfrage senden';

    // Zeitpunkt des Seitenaufrufs – dient dem serverseitigen Zeit-Check.
    const loadedAt = Date.now();

    const showStatus = (message: string, state: 'success' | 'error') => {
      if (!status) return;
      status.textContent = message;
      status.dataset.state = state;
      status.hidden = false;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!consent?.checked) {
        showStatus(
          'Bitte bestätigen Sie die Datenschutzerklärung, um Ihre Anfrage zu senden.',
          'error'
        );
        consent?.focus();
        return;
      }

      const val = (name: string) =>
        (form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null)?.value ?? '';

      const data = {
        name: val('name'),
        email: val('email'),
        message: val('message'),
        company: val('company'),
        phone: val('phone'),
        area: val('area'),
        urgency: val('urgency'),
        website: val('website'), // Honeypot
        ts: loadedAt,
      };

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Wird gesendet …';
      }

      try {
        const res = await fetch('/.netlify/functions/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        const result = await res.json().catch(() => ({}));

        if (res.ok && result.ok) {
          form.reset();
          showStatus(
            'Vielen Dank für Ihre Anfrage. Wir melden uns in der Regel binnen eines Werktags.',
            'success'
          );
        } else {
          showStatus(
            result.error ??
              'Ihre Nachricht konnte nicht versendet werden. Bitte schreiben Sie uns direkt an info@rae-vp.de.',
            'error'
          );
        }
      } catch {
        showStatus(
          'Verbindung fehlgeschlagen. Bitte versuchen Sie es später erneut oder schreiben Sie uns direkt an info@rae-vp.de.',
          'error'
        );
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = submitLabel;
        }
      }
    });
  }
</script>
