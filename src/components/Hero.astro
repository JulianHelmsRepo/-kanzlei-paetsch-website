---
import { Image } from 'astro:assets';
import type { Lang } from '../i18n/ui';
import { routes, useContent } from '../i18n/utils';
import empfangPhoto from '../assets/images/empfang.png';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useContent(lang);
---

<section class="hero">
  <div class="container hero__inner">
    <div class="hero__content reveal">
      <p class="eyebrow">{t.hero.eyebrow}</p>
      <h1 class="hero__title">{t.hero.title}</h1>
      <p class="hero__lead lead">{t.hero.lead}</p>
      <a class="btn btn-primary" href={routes[lang].contact}>
        {t.hero.cta}<span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
    <div class="hero__media reveal">
      <Image
        src={empfangPhoto}
        alt={t.hero.imageCaption}
        widths={[400, 640, 900]}
        sizes="(max-width: 820px) 100vw, 460px"
        class="hero__photo"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3.5rem, 8vw, 6rem);
    border-bottom: 1px solid var(--c-border);
  }
  .hero__inner {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2rem, 6vw, 4rem);
    align-items: center;
  }
  .hero__title {
    font-size: clamp(2.6rem, 6.5vw, 3.6rem);
    line-height: 1.1;
    margin: 1.3rem 0 1.6rem;
    max-width: 12ch;
  }
  .hero__lead {
    margin-bottom: 2.2rem;
    max-width: 48ch;
  }
  .hero__media {
    display: flex;
    justify-content: flex-end;
  }
  .hero__photo {
    width: 100%;
    max-width: 460px;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
  }

  @media (max-width: 820px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }
    .hero__media {
      justify-content: flex-start;
      order: -1;
    }
  }
</style>
