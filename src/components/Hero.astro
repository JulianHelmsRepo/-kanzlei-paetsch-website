---
import { Image } from 'astro:assets';
import type { Lang } from '../i18n/ui';
import { routes, useContent } from '../i18n/utils';
import speicherstadtPhoto from '../assets/images/speicherstadt.png';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useContent(lang);
---

<section class="hero">
  <Image
    src={speicherstadtPhoto}
    alt=""
    widths={[900, 1400, 1920, 2400]}
    sizes="100vw"
    class="hero__bg"
  />
  <div class="hero__scrim" aria-hidden="true"></div>

  <div class="container hero__inner">
    <div class="hero__content reveal">
      <p class="eyebrow">{t.hero.eyebrow}</p>
      <h1 class="hero__title">{t.hero.title}</h1>
      <p class="hero__lead lead">{t.hero.lead}</p>
      <a class="btn btn-primary" href={routes[lang].contact}>
        {t.hero.cta}<span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>

  <p class="hero__caption">{t.hero.imageCaption}</p>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: clamp(30rem, 74vh, 46rem);
    overflow: hidden;
    border-bottom: 1px solid var(--c-border);
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      rgba(255, 255, 255, 0.94) 0%,
      rgba(255, 255, 255, 0.86) 24%,
      rgba(255, 255, 255, 0.4) 48%,
      rgba(255, 255, 255, 0.05) 66%,
      rgba(255, 255, 255, 0) 78%
    );
  }
  .hero__inner {
    position: relative;
    width: 100%;
  }
  .hero__content {
    max-width: 34rem;
  }
  .hero__title {
    font-size: clamp(2.6rem, 6.5vw, 3.6rem);
    line-height: 1.1;
    margin: 1.3rem 0 1.6rem;
    max-width: 12ch;
  }
  .hero__lead {
    margin-bottom: 2.2rem;
    max-width: 44ch;
  }
  .hero__caption {
    position: absolute;
    right: var(--gutter);
    bottom: 1.1rem;
    z-index: 1;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--c-text-subtle);
    background: rgba(255, 255, 255, 0.82);
    padding: 0.3rem 0.6rem;
    border-radius: 1px;
  }

  @media (max-width: 820px) {
    .hero {
      min-height: 36rem;
      align-items: flex-end;
      padding-bottom: 4.5rem;
    }
    .hero__scrim {
      background: linear-gradient(
        180deg,
        rgba(255, 255, 255, 0.55) 0%,
        rgba(255, 255, 255, 0.88) 55%,
        rgba(255, 255, 255, 0.96) 100%
      );
    }
    .hero__content {
      max-width: none;
    }
    .hero__caption {
      left: var(--gutter);
      right: var(--gutter);
      bottom: 0.75rem;
    }
  }
</style>
