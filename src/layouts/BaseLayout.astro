---
// Selbstgehostete Schriften (DSGVO: keine Google-Fonts-CDN-Aufrufe)
import '@fontsource/spectral/400.css';
import '@fontsource/spectral/500.css';
import '@fontsource/spectral/600.css';
import '@fontsource/spectral/400-italic.css';
import '@fontsource-variable/work-sans';
import '@fontsource/jetbrains-mono/400.css';
import '../styles/global.css';

import type { Lang, PageKey } from '../i18n/ui';
import { firm, routes } from '../i18n/ui';
import { useContent } from '../i18n/utils';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  lang: Lang;
  page: PageKey;
  title?: string;
  description?: string;
}
const { lang, page, title, description } = Astro.props;
const t = useContent(lang);
const meta = t.meta[page];
const pageTitle = title ?? meta.title;
const pageDesc = description ?? meta.description;

const site = Astro.site ?? new URL('https://www.rae-vp.de');
const canonical = new URL(routes[lang][page], site).href;
const deUrl = new URL(routes.de[page], site).href;
const enUrl = new URL(routes.en[page], site).href;

// Strukturierte Daten für die Kanzlei
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LegalService',
  name: `${firm.name} — ${firm.legalName}`,
  url: site.href,
  telephone: firm.phoneDisplay,
  email: firm.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: firm.street,
    postalCode: firm.city.split(' ')[0],
    addressLocality: firm.city.split(' ').slice(1).join(' '),
    addressCountry: firm.country,
  },
  areaServed: 'Hamburg',
  knowsAbout: t.practiceAreas.map((a) => a.title),
};
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonical} />

    <link rel="alternate" hreflang="de" href={deUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={deUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={firm.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_US'} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />

    <meta name="theme-color" content="#0b2a4a" />
    <meta name="generator" content={Astro.generator} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.a11y.skipToContent}</a>
    <Header lang={lang} page={page} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
  main {
    flex: 1 0 auto;
  }
</style>
